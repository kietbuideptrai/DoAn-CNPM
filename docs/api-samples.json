  "analyticsPageview": {
    "request": {
      "method": "POST",
      "url": "https://api.example.test/api/analytics/pageview",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "visitor_id": "<VISITOR_UUID_VALID>",
        "path": "/artifacts/a-1-skyraider"
      }
    },
    "response": {
      "status": 204,
      "body": null,
      "_note": "Thay <VISITOR_UUID_VALID> bằng UUID v4 do client tạo. path phải bắt đầu bằng /, dài 1–300 ký tự và không được bắt đầu bằng /admin. Server tự tách artifact_slug từ /artifacts/:slug; không lưu IP/user-agent."
    }
  },

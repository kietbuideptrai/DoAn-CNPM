  "adminLogin": {
    "request": {
      "method": "POST",
      "url": "https://api.example.test/api/admin/auth/login",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "email": "admin@example.test",
        "password": "<ADMIN_PASSWORD_FROM_SECRET_STORE>"
      }
    },
    "response": {
      "status": 200,
      "body": {
        "token": "<ADMIN_TOKEN>"
      }
    }
  },

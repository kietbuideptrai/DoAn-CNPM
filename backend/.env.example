# Copy to .env and fill in locally. Never commit real credentials.
# PostgreSQL connection string for a confirmed non-production Supabase project.
# Keep TLS enabled. See README.md and src/db/README.md before running schema or seed.
DATABASE_URL=

# Port for the local API server. Render/Railway provide PORT automatically.
PORT=3000

# Comma-separated exact web origins allowed by CORS.
# Local Vite origins are allowed even when this is empty.
CORS_ORIGINS=

NODE_ENV=development

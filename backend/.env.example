# Copy to .env and fill in locally. Never commit real credentials.
# PostgreSQL connection string for a confirmed non-production Supabase project.
# Keep TLS enabled. See README.md and src/db/README.md before running schema or seed.
DATABASE_URL=

# Project ref of the approved non-production Supabase project. Used by
# `npm run setup:supabase` to verify the target before any write.
SUPABASE_PROJECT_REF=

# Port for the local API server. Render/Railway provide PORT automatically.
PORT=3000

# Comma-separated exact web origins allowed by CORS.
# Local Vite origins are allowed even when this is empty.
CORS_ORIGINS=

NODE_ENV=development

# Admin authentication. Use a long random secret in every deployed environment.
ADMIN_JWT_SECRET=
# Credentials used by `npm run seed:admin` (do not commit real values).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# `npm run setup:supabase -- --reset` is destructive and additionally requires
# CONFIRM_RESET=supabase-non-production in the environment.
CONFIRM_RESET=

# Optional explicit opt-in for `npm run seed:analytics -- --force` when the
# project was already confirmed outside this config.
ALLOW_ANALYTICS_FORCE=
